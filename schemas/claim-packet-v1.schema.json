{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siso.ai/schemas/claim-packet-v1.schema.json",
  "title": "SISO Great Library Claim Packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "question", "claim", "grounding", "action", "refresh", "provenance"],
  "properties": {
    "schema_version": { "const": "claim-packet-v1" },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "scope"],
      "properties": {
        "id": { "type": "string", "pattern": "^GQ-[0-9]{3}(:[A-Za-z0-9._-]+)?$" },
        "text": { "type": "string", "minLength": 12 },
        "scope": { "type": "string", "minLength": 3 },
        "parents": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true, "default": [] }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "position", "confidence", "status", "created_at", "updated_at"],
      "properties": {
        "id": { "type": "string", "pattern": "^claim:[A-Za-z0-9._:-]+$" },
        "position": { "type": "string", "minLength": 20 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "status": { "enum": ["proposed", "accepted", "superseded", "rejected"] },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "supersedes": { "type": "array", "items": { "type": "string", "pattern": "^claim:[A-Za-z0-9._:-]+$" }, "uniqueItems": true, "default": [] }
      }
    },
    "grounding": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["quote", "source", "locator", "byte_range"],
        "properties": {
          "quote": { "type": "string", "minLength": 12 },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "id"],
            "properties": {
              "kind": { "enum": ["book", "person", "release", "source_inventory", "external"] },
              "id": { "type": "string", "minLength": 1 },
              "title": { "type": "string" }
            }
          },
          "locator": { "type": "string", "minLength": 1 },
          "passage_id": { "type": "string", "minLength": 1 },
          "byte_range": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start", "end"],
            "properties": {
              "start": { "type": "integer", "minimum": 0 },
              "end": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "description"],
      "properties": {
        "status": { "enum": ["none", "proposed", "approved", "done", "blocked"] },
        "description": { "type": "string", "minLength": 3 },
        "owner": { "type": "string" },
        "approval_ref": { "type": "string" },
        "artifact": { "type": "string" }
      }
    },
    "refresh": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "selectors", "invalidate_on"],
      "properties": {
        "strategy": { "enum": ["manual", "on-evidence-change", "scheduled", "question-loop"] },
        "selectors": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "invalidate_on": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "run_id", "generated_at"],
      "properties": {
        "producer": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "model": { "type": "string" },
        "generated_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
