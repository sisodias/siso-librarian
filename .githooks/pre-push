#!/usr/bin/env bash
# Runs OUTSIDE the verify chain, which is the only place this check works.
#
# Measured 2026-08-05: appending `|| true` to package.json's verify script makes
# a repo with a corrupted claim exit 0. Putting the chain-guard INSIDE the chain
# does not help — the same `|| true` swallows the guard's own exit code (the
# guard exits 4 standalone, 0 through npm). A guard cannot protect the mechanism
# that invokes it.
#
# So: invoke it directly here, then run the chain.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

node scripts/audit-verify-chain.mjs --strict || {
  echo "PUSH REFUSED: the verify chain itself is compromised (see findings above)" >&2
  exit 1
}
# The full suite, not just the verify chain. Measured 2026-08-05: a change can
# pass verify and break a self-test — twice that day — and the hook only ran
# verify, so those reached the next turn unnoticed.
#
# --quick skips gates-are-load-bearing.sh, which invokes verify eight times and
# would make every push slow. That suite runs from check:all by hand. Stated so
# nobody reads this hook as covering everything.
bash scripts/check-all.sh --quick || {
  echo "PUSH REFUSED: a suite failed (see above)" >&2
  exit 1
}
